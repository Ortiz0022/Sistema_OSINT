# ==============================================================================
# Variables de Entorno - Observatorio Territorial y OSINT Costa Rica
# ==============================================================================
# Al utilizar fuentes de datos abiertos estatales (OSINT), el sistema no requiere
# llaves privadas ni credenciales secretas para su funcionamiento.
# 
# Copia este archivo como '.env' si deseas personalizar los puertos o URLs base:
# cp .env.example .env
# ==============================================================================

# Puerto del servidor backend / proxy Express (por defecto: 3001)
PORT=3001

# URL base del API backend para el frontend de Vite (opcional en desarrollo local)
# VITE_API_BASE_URL=http://localhost:3001

# --- Configuración opcional para Pipelines ETL ---

# Contenedor público de datos abiertos de SICOP (Observatorio de Compra Pública)
# SICOP_CONTAINER_URL=https://dlsaobservatorioprod.blob.core.windows.net/fs-synapse-observatorio-produccion

# Rango temporal de meses a procesar en ETL de SICOP (por defecto: 24)
# SICOP_MESES=24
# SICOP_DESDE=202401
# SICOP_HASTA=202412
